# Ansible Environment Variables
# This file contains all environment variables used by the Ansible playbooks
# Copy this file to .env and update with your values

# Database passwords
# Used for Immich PostgreSQL database
IMMICH_PG_PASS=postgres

# Pi-hole admin password
# Used to access the Pi-hole admin interface
PIHOLE_PASS=piholepass

# N8N configuration
# Data directory for n8n (should be an absolute path)
N8N_DATA_DIR=/opt/n8n
# Encryption key for n8n workflows (DO NOT change after initial setup)
N8N_ENCRYPTION_KEY=changeme
# JWT secret for n8n authentication
N8N_JWT_SECRET=changeme

# Remote Desktop (XRDP) configuration
# Username for XRDP access
XRDP_USER=rdpuser
# Password for XRDP user
XRDP_PASSWORD=rdppassword

# Git configuration
# Your Git username
GIT_USER_NAME=Alex
# Your Git email address
GIT_EMAIL=litvinovich.alexander@gmail.com

# Tailscale configuration
# Your Tailscale authentication key
TAILSCALE_KEY=