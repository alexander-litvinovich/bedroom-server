# for generating SSH keys
GIT_EMAIL=your.email@mail.com

# Immich PostgreSQL password
IMMICH_PG_PASS=postgres

# XRDP user setup
XRDP_USER=rdpuser

# Timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Helsinki

# =============================================================================
# N8N
# =============================================================================

# Path to n8n data directory (outside the repo!)
N8N_DATA_DIR=/media/storage/n8n

# Host and protocol settings
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678

# Security keys (generate with: openssl rand -hex 32)
# WARNING: Do NOT change N8N_ENCRYPTION_KEY after setup - it will break existing workflows!
N8N_ENCRYPTION_KEY=
N8N_JWT_SECRET=

# Basic Authentication (optional - disabled by default)
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# =============================================================================
# VAULTWARDEN
# =============================================================================

# Path to Vaultwarden data directory (outside the repo!)
VW_DATA_DIR=/var/lib/vaultwarden

# Public URL (your domain via Cloudflare Tunnel)
VW_PUBLIC_URL=https://vault.yourdomain.com

# Allow new user registrations (set to false after creating first user)
VW_SIGNUPS_ALLOWED=true

# Admin panel token (generate with: openssl rand -base64 48)
# Remove or leave empty to disable admin panel after setup
VW_ADMIN_TOKEN=

# Cloudflare Tunnel token from Zero Trust dashboard
# (Networks → Tunnels → your tunnel → Install connector → Docker)
VW_CF_TUNNEL_TOKEN=

# =============================================================================
# KAVITA
# =============================================================================

# Path to Kavita library and config directories (outside the repo!)
KAVITA_BOOKS=/media/storage/kavita/books
KAVITA_CONFIG=/media/storage/kavita/config

# =============================================================================
# PI-HOLE
# =============================================================================

# Path to Pi-hole data directory (outside the repo!)
PIHOLE_DATA_DIR=/var/lib/pihole

# Web interface password
PIHOLE_PASS=changeme

# DNS listening mode: all, local, single, bind
PIHOLE_DNS_LISTENING_MODE=all

# =============================================================================
# NGINX PROXY MANAGER
# =============================================================================

# Base path for Nginx Proxy Manager volumes (outside the repo!)
# The container will use ${NGINX_PROXY_MANAGER_VOLUMES}/data and /letsencrypt
NGINX_PROXY_MANAGER_VOLUMES=/media/storage/nginx-proxy-manager

# =============================================================================
# IMMICH
# =============================================================================

# Container path for Immich media (mounted to UPLOAD_LOCATION)
IMMICH_MEDIA_LOCATION=/data

# Compose/app expected vars (mirror IMMICH_* above)
UPLOAD_LOCATION=/media/storage/immich/library
DB_DATA_LOCATION=/media/storage/immich/postgres

# PostgreSQL db creds
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_PASSWORD=postgres

# Immich version (use "release" for latest or pin like "v1.123.0")
IMMICH_VERSION=release

# =============================================================================
# CODEX WORKER VMS
# =============================================================================

# Generic user inside every VM
CODEX_VM_GUEST_USER=vmuser

# Wired host interface used by Incus macvlan. Check with: ip -br link
CODEX_VM_PARENT_NIC=eno1

# Static addresses reserved outside the router's DHCP range
CODEX_VM_CIDR=192.168.1.0/24
CODEX_VM_HOST_IP=192.168.1.200
CODEX_VM_GATEWAY=192.168.1.1
CODEX_VM_DNS=192.168.1.1
CODEX_VM_IP_START=192.168.1.201
CODEX_VM_IP_END=192.168.1.220

# Thin-provisioned host pool and per-VM resources. The source must be on a
# persistent, non-root ext4 or xfs mount.
CODEX_VM_STORAGE_SOURCE=/media/storage/incus/codex-workers.img
CODEX_VM_STORAGE_SIZE=60GiB
CODEX_VM_DISK_SIZE=20GiB
CODEX_VM_MEMORY=2GiB
CODEX_VM_CPUS=2
